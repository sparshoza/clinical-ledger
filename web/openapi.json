  "info": {
    "description": "A tamper-evident, versioned clinical record ledger. Every change is a new version, every event is chained by SHA-256, and each demo visitor gets a private tenant isolated by PostgreSQL row-level security. All data is synthetic (Synthea).",
    "title": "Clinical Ledger API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/auth/demo": {
      "post": {
        "description": "Sign in as a demo role. A valid token for a live tenant keeps that tenant.",
        "operationId": "demo_sign_in_api_v1_auth_demo_post",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DemoSignIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Start or switch a demo session",
        "tags": [
          "auth"
        ]
      }
    },
