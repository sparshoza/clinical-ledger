# Copy to .env and fill in. Never commit .env.

# PostgreSQL. The app connects as the restricted ledger_app role.
DATABASE_URL=postgresql://ledger_app:change-me@localhost:5432/clinical_ledger
# Owner connection, used only by migrations and scripts.
DATABASE_URL_OWNER=postgresql://postgres:change-me@localhost:5432/clinical_ledger
# Password the migration assigns to the ledger_app role.
LEDGER_APP_PASSWORD=change-me
# Owner connection to a separate database for tests (its name must end in _test).
TEST_DATABASE_URL_OWNER=postgresql://postgres:change-me@localhost:5432/clinical_ledger_test

# Object storage (any S3-compatible service, e.g. Cloudflare R2).
S3_BACKEND=s3
S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET=clinical-ledger
S3_REGION=auto
S3_ACCESS_KEY_ID=change-me
S3_SECRET_ACCESS_KEY=change-me

# Signing secret for demo tokens, and the secret the scheduled cleanup job sends.
JWT_SECRET=change-me
CRON_SECRET=change-me
